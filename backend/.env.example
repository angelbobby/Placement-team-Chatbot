# ─────────────────────────────────────────────────
#  Placement Cell Chatbot – Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Hugging Face API Token (required for AI chat)
# Get yours free at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Hugging Face Model (optional, defaults to Qwen2.5-7B)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# MongoDB URI (optional, uses in-memory mock if not set)
# MONGO_URI=mongodb://localhost:27017/

# Server Port (default: 5000)
# PORT=5000
